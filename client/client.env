# Edge-node settings for the sealed client image.
# Start with: docker compose --env-file client.env -f client/docker-compose.yml up -d
# Replace every change-me value before a shop goes live. Do not commit real secrets.

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=pos_db
DB_USER=posUser
DB_PASS=change-me
DB_ROOT_PASS=change-me-root

APP_ENV=production
APP_DEBUG=false
TZ=Africa/Lusaka

APP_PORT=8090
CLIENT_BIND_ADDR=127.0.0.1
CLIENT_APP_IMAGE=smarttradepos-pro-client:sealed

ZRA_TPIN=
ZRA_BHF_ID=000
ZRA_DVC_SRL_NO=
ZRA_VSDC_URL=http://vsdc:8080/sandboxvsdc
ZRA_PORTAL_URL=https://www.zra.org.zm
ZRA_NON_VAT=false

VSIAS_URL=http://localhost:8095
VSIAS_INTERNAL_URL=http://host.docker.internal:8095
VSIAS_BRIDGE_TOKEN=change-me
VSIAS_DEFAULT_LOCATION_ID=
VSIAS_DEFAULT_VENDOR_ID=
VSIAS_DEFAULT_USER_ID=

# Live + Offline Edge Synchronization
# Leave SYNC_NODE_ROLE=edge and ZRA_VSDC_MODE=remote when paired with an Online HQ server.
SYNC_NODE_ROLE=edge
SYNC_ONLINE_URL=https://smartrade.odeliazm.com
SYNC_NODE_TOKEN=
SYNC_LOCATION_ID=1
ZRA_VSDC_MODE=remote

