### Git revert to specific branch

# Add all current changes (if any are uncommitted)
git add .
git commit -m "<message_here>"

# Create and switch to a new quarantine branch
git checkout -b <New_Branch_Name>

# Push this branch to your remote repository for safe keeping
git push -u origin <New_Branch_Name>

# Switch back to your main branch (use 'master' if your repo uses master)
git checkout main

# View your commit history (Press 'q' to exit the log view)
git log --oneline

# Execute the Rollback - Hard reset your working branch to the last functional commit;
git reset --hard <previous_working_commit_hash>

