# --- MySQL Database Settings ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=pos_db
DB_USER=posUser
DB_PASS=secret_password_here
DB_ROOT_PASS=secret_root_password_here

# --- App Settings ---
APP_ENV=local
APP_DEBUG=true
