# --- MySQL Database Settings ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=pos_db
DB_USER=posUser
DB_PASS=secret_password_here
DB_ROOT_PASS=secret_root_password_here

# --- App Settings ---
APP_ENV=local
APP_DEBUG=true
TZ=Africa/Lusaka

# --- Port Configuration ---
APP_PORT=8090
DB_PORT_EXTERNAL=8091
PHPMYADMIN_PORT=8092
ADMINER_PORT=8093
VSDC_PORT=8080

# --- ZRA Smart Invoice (must match Device Management on the ZRA portal) ---
# ZRA_VSDC_URL is the LOCAL Tomcat VSDC. Never set this to https://www.zra.org.zm
ZRA_TPIN=tpin_number_here
ZRA_BHF_ID=000
ZRA_DVC_SRL_NO=your_device_serial_as_is_on_zra_portal
ZRA_VSDC_URL=http://vsdc:8080/sandboxvsdc
# Receipt QR portal. Sandbox: https://sandboxportal.zra.org.zm
# Production: https://www.zra.org.zm
ZRA_PORTAL_URL=https://sandboxportal.zra.org.zm
# Set 'ZRA_NON_VAT' to true for Turnover Tax (TOT) clients, false for standard VAT
ZRA_NON_VAT=true

# --- V-SIAS inspection bridge ---
# Browser iframes rewrite localhost to the host you used to open the POS (phones on LAN).
# Server-to-server calls use VSIAS_INTERNAL_URL.
VSIAS_URL=http://localhost:8095
VSIAS_INTERNAL_URL=http://host.docker.internal:8095
VSIAS_BRIDGE_TOKEN=vsias_bridge_8f7d9a2b4c6e1mando99384
VSIAS_DEFAULT_LOCATION_ID=
VSIAS_DEFAULT_VENDOR_ID=
VSIAS_DEFAULT_USER_ID=
