<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Tokenized Hosted Receipt Short Link:
    #    https://smartrade.odeliazm.com/r/<token>      -> r/index.php?t=<token>
    RewriteRule ^r/([A-Za-z0-9_-]+)/?$ r/index.php?t=$1 [QSA,L]

    # 2. Clean WhatsApp Express Storefront Short Links:
    #    https://smartrade.odeliazm.com/order          -> storefront/index.php
    #    https://smartrade.odeliazm.com/order/2        -> storefront/index.php?branch=2
    RewriteRule ^order/?$ storefront/index.php [QSA,L]
    RewriteRule ^order/([0-9]+)/?$ storefront/index.php?branch=$1 [QSA,L]

    # 3. Clean POS Kitchen Display System (KDS) Short Links:
    #    https://smartrade.odeliazm.com/kds            -> storefront/kds.php
    #    https://smartrade.odeliazm.com/kds/2          -> storefront/kds.php?branch=2
    RewriteRule ^kds/?$ storefront/kds.php [QSA,L]
    RewriteRule ^kds/([0-9]+)/?$ storefront/kds.php?branch=$1 [QSA,L]

    # 4. Microsoft Teams join link:
    #    https://smartrade.odeliazm.com/teams/join/<token> -> teams/join.php?t=<token>
    RewriteRule ^teams/join/([A-Za-z0-9_-]+)/?$ teams/join.php?t=$1 [QSA,L]
</IfModule>
